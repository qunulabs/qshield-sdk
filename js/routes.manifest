# Every qshield route this SDK calls.
#
# ADDING A CALL MEANS ADDING ITS ROUTE HERE, IN THE SAME CHANGE. A Go test in
# backend/internal/router walks the real mounted router and fails when a route
# named here no longer exists. That is what turns a rename inside qshield into a
# red test on the pull request that causes it, instead of a broken customer
# integration discovered after an upgrade.
#
# One route per line: METHOD /absolute/path, with {param} for a path parameter,
# written exactly as the router declares it. Lines starting with # and blank
# lines are ignored.
#
# This file is a deliberate declaration, not something derived from the source.
# It checks existence only; shapes and behaviour are the contract harness's job.

POST /api/v1/auth/token

# Vault keys (C1). Note DELETE is the one route in the whole vault tree that
# answers 204 with an empty body; every other delete answers 200 with a status
# object, so the shape cannot be inferred from the verb.
GET /api/v1/vault/keys
POST /api/v1/vault/keys
GET /api/v1/vault/keys/{alias}
GET /api/v1/vault/keys/{alias}/versions
GET /api/v1/vault/keys/{alias}/public-key
POST /api/v1/vault/keys/{alias}/rotate
DELETE /api/v1/vault/keys/{alias}

# Vault crypto operations (C2). All seven take an optional key version and all
# seven answer 503 while the vault is sealed, which is never retried.
POST /api/v1/vault/keys/{alias}/sign
POST /api/v1/vault/keys/{alias}/verify
POST /api/v1/vault/keys/{alias}/encrypt
POST /api/v1/vault/keys/{alias}/decrypt
POST /api/v1/vault/keys/{alias}/hmac
POST /api/v1/vault/keys/{alias}/encapsulate
POST /api/v1/vault/keys/{alias}/decapsulate

# Vault data keys (C2), for envelope encryption. The SDK always asks for the key
# itself and never supplies a transport key, so the two routes below are the
# whole surface.
#
# The SDK always asks for the plaintext half, because envelope encryption is the only
# reason to call this and a wrapped-only key would encrypt nothing. So a service account
# using client.vault.dataKeys MUST hold vault:datakey:plaintext; without it qshield
# refuses the whole call with EVT-010 rather than answering with the field quietly
# missing. That is a least-privilege obligation on whoever provisions the credential.
POST /api/v1/vault/datakey
POST /api/v1/vault/datakey/unwrap

# Vault time-constrained keys (C3). Keys with a validity window, whose material
# is DESTROYED when the window closes rather than disabled. Three route-level
# facts worth knowing here: create answers 201, destroy answers 200 with a status
# object rather than 204, and encapsulate reads no request body at all.
GET /api/v1/vault/tc-keys
POST /api/v1/vault/tc-keys
GET /api/v1/vault/tc-keys/{alias}
GET /api/v1/vault/tc-keys/{alias}/public-key
POST /api/v1/vault/tc-keys/{alias}/encrypt
POST /api/v1/vault/tc-keys/{alias}/decrypt
POST /api/v1/vault/tc-keys/{alias}/encapsulate
POST /api/v1/vault/tc-keys/{alias}/decapsulate
POST /api/v1/vault/tc-keys/{alias}/extend
POST /api/v1/vault/tc-keys/{alias}/destroy
